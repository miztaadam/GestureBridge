<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- This is a watch-only app. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- ===== Permissions ===================================================== -->

    <!-- Network: send the webhook POSTs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wake lock: keep the CPU awake for the few seconds a request takes when
         the trigger arrives while the screen is dimmed or off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Haptics: success / failure feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service + its notification (which carries the Ongoing Activity).
         "specialUse" is the service type because none of the predefined types
         describes "wait for a button press and send a webhook". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restart the keep-alive service after the watch reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Key-event interception has NO <uses-permission>. It is granted by the user
         switching the accessibility service on in the watch's Settings, and the
         service below is protected with BIND_ACCESSIBILITY_SERVICE so that only
         the system can bind to it. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The app works without a phone companion app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Config screen. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible "fire and close" activity. It is reached only through the two
             aliases below, which show up in the app list as "GB Gesture" and
             "GB Button". Assign one to a button in the watch's
             Settings > Buttons and gestures to fire a webhook with a hardware press. -->
        <activity
            android:name=".ui.FireActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.gesturebridge.fire"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity-alias
            android:name=".FireGesture"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/shortcut_gesture"
            android:targetActivity=".ui.FireActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".FireButton"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/shortcut_button"
            android:targetActivity=".ui.FireActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hardware key interception. Enable it on the watch under
             Settings > Accessibility > Installed apps > GestureBridge. -->
        <service
            android:name=".service.KeyInterceptService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Keeps the process alive and shows the Ongoing Activity indicator. -->
        <service
            android:name=".service.BridgeForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for a hardware button or gesture trigger and sends a user-configured webhook." />
        </service>

        <!-- Intent entry point for gesture triggers (see GestureIntentReceiver.kt).
             It requires the DUMP permission, which only the system and the adb shell
             hold, so other apps on the watch cannot fire your webhooks. -->
        <receiver
            android:name=".service.GestureIntentReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.gesturebridge.action.TRIGGER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
